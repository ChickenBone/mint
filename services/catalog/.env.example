# Public identification, not an API key. Replace with your own application/contact.
CRAWLER_USER_AGENT=MintCatalog/0.1 (https://github.com/ChickenBone/mint)
MUSICBRAINZ_ENABLED=true
LISTENBRAINZ_ENABLED=true
# Unofficial, unauthenticated YouTube Music discovery. No browser cookies required.
YTMUSIC_ENABLED=true
# Public YouTube channel feeds and video oEmbed metadata.
YOUTUBE_ENABLED=true
# Optional comma-separated UC... channel IDs (not handles or names).
YOUTUBE_CHANNELS=
# Additional no-key adapters. Remove a name to disable it; no account or tokens.
PUBLIC_SOURCES=spotify,deezer,audius,archive,wikidata,soundcloud,openverse,discogs,openwhyd
# Optional: review Apple's current permitted uses before enabling.
APPLE_ENABLED=false
COUNTRIES=us
CATALOG_PORT=8097
# Mint connection, read only by compose.consumer.yml (docker compose -f compose.yml -f compose.consumer.yml).
# The read API answers only to loopback Host names unless ALLOWED_HOSTS lists more: comma-separated bare
# DNS names or IPv4 addresses, no schemes, ports or wildcards, at most 16 names beyond the built-in loopback ones.
# The override sets ALLOWED_HOSTS from this value so Mint containers on the mint-catalog-link network can
# call http://catalog-search:8080; keep catalog-search in the list if you replace it. The API is
# unauthenticated and read-only: keep that network private and never publish the search port publicly.
# CATALOG_ALLOWED_HOSTS=catalog-search
# Optional shared secret (32-256 printable characters, e.g. `openssl rand -hex 32`). Set the same value
# for Mint to let its searches, opened artist/album pages and recorded plays steer crawl priority via
# POST /v1/demand. Hints are anonymous and bounded; leave empty to disable the endpoint.
# CATALOG_DEMAND_TOKEN=
MAX_ENTITIES=10000000
# Optional large snapshot loader (docker compose --profile bulk up -d bulk-import).
# Keep downloads outside the database volumes; budget disk for metadata AND vectors.
CATALOG_IMPORT_DIRECTORY=./imports
# Empty selects latest on start; pin YYYYMMDD-HHMMSS for a reproducible snapshot.
MUSICBRAINZ_SNAPSHOT=
SOURCE_INTERVAL_SECONDS=4
# Optional per-source seconds, including fractions. Set only to permitted rates.
# SOURCE_INTERVAL_OVERRIDES=apple=3,ytmusic=1,deezer=0.5
# Minimum intervals: MusicBrainz 1s, Discogs 2.5s, Openwhyd 2s.
SOURCE_INTERVAL_OVERRIDES=
CHART_INTERVAL_SECONDS=21600
# Concurrent sessions per crawler process; source budgets remain shared.
CRAWLER_WORKERS=8
# Independent embedding models per indexer process; each uses the thread count below.
INDEXER_WORKERS=2
INDEX_BATCH_SIZE=64
EMBEDDING_THREADS=2
