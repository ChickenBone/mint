# Home server entry points when the website runs on Vercel.
# DNS: ws.mint.chickenbone.dev and hub.mint.chickenbone.dev -> this host.

ws.{$MINT_DOMAIN} {
	reverse_proxy realtime:3001 {
		header_up X-Forwarded-For {remote_host}
	}
	log {
		output stdout
		format console
	}
}

hub.{$MINT_DOMAIN} {
	encode {
		zstd
		gzip
		match {
			header Content-Type image/*
		}
	}

	# Volunteer uploads: one song per request, streamed straight to staging.
	@ingest path /ingest/*
	handle @ingest {
		request_body {
			max_size 250MB
		}
		reverse_proxy hub:8090 {
			header_up X-Forwarded-For {remote_host}
			transport http {
				read_timeout 1h
				write_timeout 1h
			}
		}
	}

	handle {
		respond 404
	}

	log {
		output stdout
		format console
	}
}
