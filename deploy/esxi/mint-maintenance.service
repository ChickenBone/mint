[Unit]
Description=Admit disruptive Mint changes only in the Central maintenance window
Wants=network-online.target apt-daily-upgrade.service
After=network-online.target docker.service apt-daily-upgrade.service
Requires=docker.service
ConditionPathExists=/etc/mint/settings.env

[Service]
Type=oneshot
EnvironmentFile=-/etc/mint/deploy.env
ExecStart=/usr/bin/python3 /usr/local/sbin/mint-deploy --maintenance
TimeoutStartSec=45min
UMask=0077
