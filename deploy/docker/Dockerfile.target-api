# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim AS dependencies
WORKDIR /repo
RUN corepack enable
COPY . .
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --filter @mint/api...
RUN node deploy/docker/target-migrations.mjs

FROM node:22-bookworm-slim AS target-api
ENV NODE_ENV=production
WORKDIR /repo/apps/api
COPY --from=dependencies --chown=node:node /repo/node_modules /repo/node_modules
COPY --from=dependencies --chown=node:node /repo/packages /repo/packages
COPY --from=dependencies --chown=node:node /repo/apps/api /repo/apps/api
COPY --from=dependencies --chown=node:node /repo/package.json /repo/tsconfig.base.json /repo/
COPY --from=dependencies --chown=node:node /repo/deploy/docker/target-migrations.mjs /repo/deploy/docker/target-migrations.mjs
COPY --chmod=755 deploy/docker/target-api-entrypoint.sh /usr/local/bin/target-api-entrypoint
USER node
ENTRYPOINT ["target-api-entrypoint"]
CMD ["node", "--import", "tsx", "src/main.ts"]
