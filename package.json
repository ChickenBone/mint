{
  "name": "mint",
  "private": true,
  "version": "3.5.0",
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "nx": "24.0.6"
  },
  "scripts": {
    "dev:web": "nx run @mint/web:dev",
    "dev:worker": "nx run @mint/worker:dev",
    "dev:realtime": "nx run @mint/realtime:dev",
    "dev:hub": "nx dev:hub @mint/worker",
    "dev:agent": "nx run @mint/agent:dev",
    "build": "nx run-many --target=build --projects=@mint/worker,@mint/realtime,@mint/agent,@mint/web",
    "typecheck": "nx run-many --target=typecheck --all",
    "lint": "nx run-many --target=lint --all",
    "test": "nx run-many --target=test --all",
    "db:generate": "nx db:generate @mint/core",
    "db:migrate": "nx db:migrate @mint/core",
    "agents": "node scripts/agents/cli.mjs",
    "agents:sync": "node scripts/agents/cli.mjs sync",
    "agents:check": "node scripts/agents/cli.mjs check",
    "test:agents": "node --test scripts/agents/lib.test.mjs",
    "test:workspace": "node --test scripts/workspace/workspace.test.mjs"
  }
}
