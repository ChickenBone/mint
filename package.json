{
  "name": "mint",
  "private": true,
  "version": "3.5.0",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "npm run dev -w @mint/web",
    "dev:worker": "npm run dev -w @mint/worker",
    "dev:realtime": "npm run dev -w @mint/realtime",
    "dev:hub": "npm run dev:hub -w @mint/worker",
    "dev:agent": "npm run dev -w @mint/agent",
    "build": "npm run build -w @mint/worker -w @mint/realtime -w @mint/agent -w @mint/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate -w @mint/core",
    "db:migrate": "npm run db:migrate -w @mint/core",
    "agents": "node scripts/agents/cli.mjs",
    "agents:sync": "node scripts/agents/cli.mjs sync",
    "agents:check": "node scripts/agents/cli.mjs check",
    "test:agents": "node --test scripts/agents/lib.test.mjs"
  }
}
