# Copy to .env for `npm run dev:*` against docker-compose.dev.yml.
PUBLIC_URL=http://localhost:3000
# Default local Expo web port. Add the actual browser origin if you use another port/host.
NATIVE_WEB_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws
DATABASE_URL=postgres://mint:mint@localhost:5432/mint
REDIS_URL=redis://localhost:6379
ENCRYPTION_KEY=
MINT_SIGNING_SECRET=
HUB_URL=http://localhost:8090
PLAYBACK_WORKER_URL=http://localhost:8080
REMOTE_DOWNLOADS=auto
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=change-me-please
STAGING_DIR=./data/staging
MUSIC_DIR=./data/music
MIGRATIONS_DIR=../../packages/core/migrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Spotify rejects "localhost" redirect URIs. Use PUBLIC_URL=http://127.0.0.1:3000
# (and matching ALLOWED_ORIGINS), then register /api/oauth/spotify/callback.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_API_MODE=development
LIDARR_ENABLED=false
COBALT_URL=http://localhost:9000
TORBOX_API_KEY=
PLEX_URL=http://localhost:32400
PLEX_TOKEN=
PLEX_MUSIC_SECTION_ID=
