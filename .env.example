# Mint .env. Set MINT_DOMAIN before deployment. All other settings are optional.
# Secrets, the database password and the admin login are generated on first
# boot (see them with `docker compose run --rm init`).

# ─── The three you'll most likely want ───────────────────────────────
# Your domain, pointed at this machine with ports 80 and 443 open. Turns on HTTPS automatically.
MINT_DOMAIN=mint.example.com
# From https://plex.tv/claim. Valid for 4 minutes and only needed on Plex's very first start.
PLEX_CLAIM=
# Google Cloud OAuth client (YouTube Data API v3). Without it members can't link YouTube Music.
# Redirect URI: https://<MINT_DOMAIN>/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Spotify playlist metadata (optional; independent from Google) ───
# Register https://<MINT_DOMAIN>/api/oauth/spotify/callback exactly.
# App owner Premium + user allowlist required in development mode; see docs/spotify.md.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_API_MODE=development

# ─── Better sources (optional) ───────────────────────────────────────
# With a TorBox key, Mint fetches full releases through Lidarr first and only rips YouTube as a fallback.
# The worker sets up Lidarr's root, torrent/NZB clients and bundled Prowlarr public indexers.
TORBOX_API_KEY=
AUTO_CONFIGURE_INDEXERS=true
PROWLARR_PUBLIC_INDEXERS=internetarchive,thepiratebay,limetorrents,1337x
# Optional music-capable Newznab indexer: this account is separate from TorBox Pro.
# API availability/limits may require a paid indexer plan. Mint cannot register it for you.
USENET_INDEXER_URL=
USENET_INDEXER_API_KEY=
# USENET_INDEXER_API_PATH=/api

# ─── First admin ─────────────────────────────────────────────────────
ADMIN_EMAIL=admin@mint.local
ADMIN_NAME=Admin
# Leave empty to have one generated.
ADMIN_PASSWORD=

# ─── Where the music lives ───────────────────────────────────────────
# Mounted at /music in the worker, Lidarr and Plex. Folders are created and handed to PUID:PGID on boot.
MUSIC_PATH=./data/music
BLACKHOLE_PATH=./data/blackhole
PUID=1000
PGID=1000
TZ=Etc/UTC

# ─── Ports (change if 80/443 are taken) ──────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443

# ─── Website on Vercel instead (see README) ──────────────────────────
# COMPOSE_FILE=docker-compose.yml:docker-compose.vercel.yml
# DATABASE_URL=postgres://...neon.tech/mint?sslmode=require   (Neon direct connection string)
# REDIS_URL=rediss://...upstash.io:6379
# PUBLIC_URL=https://mint.example.com
# ALLOWED_ORIGINS=https://mint.example.com

# ─── Images ──────────────────────────────────────────────────────────
GHCR_OWNER=chickenbone
MINT_TAG=latest

# ─── Overrides (normally generated or derived) ───────────────────────
# PUBLIC_URL=            defaults to https://$MINT_DOMAIN; production login requires HTTPS
# ENCRYPTION_KEY=        32 random bytes, base64
# MINT_SIGNING_SECRET=
# PLAYBACK_WORKER_URL=http://worker:8080   private worker health/media gateway; never publish port 8080
# MINT_CHARTS_ENABLED=true               keyless Apple Music, ListenBrainz and Audius charts; false disables external chart requests
# PLEX_TOKEN=            read from Plex once it's claimed
# PLEX_MUSIC_SECTION_ID= found or created by the worker
# LIDARR_API_KEY=        read from Lidarr's config
# PROWLARR_API_KEY=      read from Prowlarr's config

# ─── Lidarr ──────────────────────────────────────────────────────────
# auto: on when TORBOX_API_KEY is set. true: on regardless (you run your own download client). false: off.
LIDARR_ENABLED=auto
# 0 = use the first profile Lidarr reports.
LIDARR_QUALITY_PROFILE_ID=0
LIDARR_METADATA_PROFILE_ID=0
# Fall back to a YouTube rip if Lidarr hasn't grabbed anything after this long…
LIDARR_GRAB_TIMEOUT_MINUTES=5
# …or hasn't finished importing after this long.
LIDARR_TOTAL_TIMEOUT_MINUTES=45
TORBOX_DELETE_AFTER_DOWNLOAD=true
TORBOX_CONCURRENCY=2

# ─── Volunteer workers ───────────────────────────────────────────────
# auto: give YouTube rips to volunteer workers whenever one is online; never: always rip here; always: never rip here.
REMOTE_DOWNLOADS=auto
# Pull a job back and rip it locally if no worker takes it within this many minutes.
REMOTE_WAIT_MINUTES=30
MAX_UPLOAD_MB=200
HUB_MAX_UPLOADS=8
# true = workers registered by members get jobs without admin approval.
WORKER_AUTO_APPROVE=false
# Set to an empty value to run without a local Cobalt (every rip then goes to volunteers).
# LOCAL_COBALT_URL=

# ─── Cobalt ──────────────────────────────────────────────────────────
COBALT_API_KEY=
COBALT_AUDIO_FORMAT=best
COBALT_AUDIO_BITRATE=320

# ─── Plex ────────────────────────────────────────────────────────────
# Path of the music folder as Plex sees it, if different from /music.
PLEX_MUSIC_DIR=/music
PLEX_READ_ONLY=false
INDEX_EXISTING_LIBRARY=false
# With an existing Plex server: mount the original NAS folder read-only at /existing-music.
# EXISTING_MUSIC_DIR=/existing-music
# EXISTING_PLEX_MUSIC_DIR=/media/music
PLEX_SCAN_TIMEOUT_MINUTES=5
PLEX_SONIC_TIMEOUT_HOURS=6

# ─── Tuning ──────────────────────────────────────────────────────────
SYNC_INTERVAL_MINUTES=30
ACQUIRE_CONCURRENCY=4
FINALIZE_CONCURRENCY=2
WS_MAX_PER_IP=20
LOG_LEVEL=info
MUSICBRAINZ_USER_AGENT=Mint/0.1 ( https://github.com/ChickenBone/mint )

# Mint audio analysis runs locally by default. Change its resource/schedule controls in Admin > Analysis.
# For optional offload, set these on the pipeline worker, not the public web/realtime/hub services.
# ANALYSIS_WORKER_TOKEN=         a distinct random secret of at least 32 characters
# ANALYSIS_REMOTE_ONLY=false     true disables NAS execution, but retains scheduling/backfill
# On the separate machine, use docker-compose.analysis.yml with only these settings:
# ANALYSIS_SERVER_URL=http://PRIVATE-VPN-WORKER:8080
# ANALYSIS_WORKER_TOKEN=         same dedicated analysis secret; no Plex/DB/Redis credentials
