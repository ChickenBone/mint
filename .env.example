# Home server .env (docker compose). The website's variables live in Vercel; see apps/web/.env.vercel.example.

# ─── Public ──────────────────────────────────────────────────────────
MINT_DOMAIN=mint.chickenbone.dev
PUBLIC_URL=https://mint.chickenbone.dev
# Origins allowed to open the WebSocket (comma-separated). Defaults to PUBLIC_URL.
ALLOWED_ORIGINS=https://mint.chickenbone.dev
# Shared with Vercel. Signs worker upload tokens and WebSocket tickets. Generate: openssl rand -base64 48
MINT_SIGNING_SECRET=
# Caddy config: ./deploy/Caddyfile (web on Vercel) or ./deploy/Caddyfile.selfhost (--profile selfhost-web)
CADDYFILE=./deploy/Caddyfile

# ─── Images ──────────────────────────────────────────────────────────
GHCR_OWNER=chickenbone
MINT_TAG=latest

# ─── Data tier ───────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://mint:change-me@postgres:5432/mint
REDIS_URL=redis://redis:6379
# 32 random bytes, base64. Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# ─── First admin (seeded by the worker on startup if no admin exists) ─
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ─── Google OAuth (YouTube Data API v3, read-only) ───────────────────
# Redirect URI: https://mint.chickenbone.dev/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Host paths and ownership ────────────────────────────────────────
# The same folder is mounted at /music in the worker, Lidarr and Plex.
MUSIC_PATH=/srv/mint/music
BLACKHOLE_PATH=/srv/mint/blackhole
PUID=1000
PGID=1000
TZ=Europe/London

# ─── Lidarr (behind the barrier) ─────────────────────────────────────
LIDARR_ENABLED=true
LIDARR_API_KEY=
# 0 = use the first profile Lidarr reports.
LIDARR_QUALITY_PROFILE_ID=0
LIDARR_METADATA_PROFILE_ID=0
LIDARR_ROOT_FOLDER=/music
# Fall back to a YouTube rip if Lidarr hasn't grabbed anything after this long…
LIDARR_GRAB_TIMEOUT_MINUTES=5
# …or hasn't finished importing after this long.
LIDARR_TOTAL_TIMEOUT_MINUTES=45

# ─── TorBox (Lidarr's "Torrent Blackhole" download client) ────────────
TORBOX_API_KEY=
TORBOX_DELETE_AFTER_DOWNLOAD=true
TORBOX_CONCURRENCY=2

# ─── Volunteer workers ───────────────────────────────────────────────
# auto: give YouTube rips to volunteer workers whenever one is online; never: always rip here; always: never rip here.
REMOTE_DOWNLOADS=auto
# Pull a job back and rip it locally if no worker takes it within this many minutes.
REMOTE_WAIT_MINUTES=30
MAX_UPLOAD_MB=200
HUB_MAX_UPLOADS=8
# Set to an empty value to run without a local Cobalt (every rip then goes to volunteers).
# LOCAL_COBALT_URL=

# ─── Cobalt (self-hosted, internal only) ─────────────────────────────
COBALT_API_KEY=
COBALT_AUDIO_FORMAT=best
COBALT_AUDIO_BITRATE=320

# ─── Plex ────────────────────────────────────────────────────────────
# Claim token for first boot only: https://plex.tv/claim
PLEX_CLAIM=
PLEX_TOKEN=
PLEX_MUSIC_SECTION_ID=
# Path of the music folder as Plex sees it, if different from /music.
PLEX_MUSIC_DIR=/music
PLEX_SCAN_TIMEOUT_MINUTES=5
PLEX_SONIC_TIMEOUT_HOURS=6

# ─── Tuning ──────────────────────────────────────────────────────────
SYNC_INTERVAL_MINUTES=30
ACQUIRE_CONCURRENCY=4
FINALIZE_CONCURRENCY=2
PREVIEW_SECONDS=30
WS_MAX_PER_IP=20
LOG_LEVEL=info
MUSICBRAINZ_USER_AGENT=Mint/0.1 ( https://mint.chickenbone.dev )
