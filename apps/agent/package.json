{
  "name": "@mint/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.js --sourcemap --define:AGENT_VERSION=\\\"$npm_package_version\\\"",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@mint/core": "*",
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
