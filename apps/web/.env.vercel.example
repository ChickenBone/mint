# Environment variables for the Vercel project (Settings -> Environment Variables).
# Root Directory: apps/web. Framework preset: Next.js. Install/build commands: defaults.

PUBLIC_URL=https://mint.chickenbone.dev

# Neon: the POOLED connection string (host contains "-pooler").
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/mint?sslmode=require
# Upstash: rediss:// TCP endpoint, same database as the home server.
REDIS_URL=rediss://default:PASSWORD@xxxx.upstash.io:6379

# Same values as the home server .env
ENCRYPTION_KEY=
MINT_SIGNING_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Home server WebSocket endpoint (baked into the client bundle and CSP at build time)
NEXT_PUBLIC_WS_URL=wss://ws.mint.chickenbone.dev/ws
# Where volunteer workers upload (server-side only)
HUB_URL=https://hub.mint.chickenbone.dev
MAX_UPLOAD_MB=200

# Volunteer workers
AGENT_IMAGE=ghcr.io/chickenbone/mint-agent:latest
# true = workers registered by members start receiving jobs without admin approval
WORKER_AUTO_APPROVE=false
