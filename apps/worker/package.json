{
  "name": "@mint/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "esbuild src/index.ts src/hub.ts --bundle --platform=node --target=node22 --format=esm --outdir=dist --external:bullmq --external:ioredis --external:pg --external:drizzle-orm --external:pino --external:@node-rs/argon2 --sourcemap",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test src/*.test.ts src/**/*.test.ts",
    "dev:hub": "tsx watch --env-file-if-exists=../../.env src/hub.ts",
    "start:hub": "node --enable-source-maps dist/hub.js"
  },
  "dependencies": {
    "@mint/core": "*",
    "@node-rs/argon2": "^2.2.2",
    "bullmq": "^5.81.5",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^5.11.1",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
